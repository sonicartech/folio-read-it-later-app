# Folio Help Center - static export served by Hostinger (LiteSpeed/Apache)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Content types for generated files
AddType text/markdown;charset=utf-8 .md
AddType text/plain;charset=utf-8 .txt
AddType application/manifest+json .webmanifest
<Files "search">
  ForceType application/json
</Files>
<Files "opengraph-image">
  ForceType image/png
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Markdown version of a docs page: /docs/faqs.md -> /llms.mdx/docs/faqs/content.md
  RewriteRule ^docs/(.+)\.md$ /llms.mdx/docs/$1/content.md [L]

  # AI agents asking for Markdown (Accept: text/markdown) get the Markdown version
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteRule ^docs/(.+?)/?$ /llms.mdx/docs/$1/content.md [L]
</IfModule>

<IfModule mod_headers.c>
  # Docs pages have an HTML and a Markdown representation (see Accept rule above)
  Header merge Vary Accept
  <FilesMatch "\.(md|txt)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/markdown text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
